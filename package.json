{
  "name": "upingdrama",
  "version": "1.3.0",
  "description": "UpingDrama - 专业 AI 短剧创作平台 (基于 LocalMiniDrama 增强版)",
  "main": "desktop/main.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:front\" \"npm run dev:backend\" \"npm run dev:desktop\"",
    "dev:front": "cd frontweb && npm run dev",
    "dev:backend": "cd backend-node && npm run dev",
    "dev:desktop": "cd desktop && npm start",
    "build": "npm run build:backend && npm run build:front && npm run build:desktop",
    "build:front": "cd frontweb && npm run build",
    "build:backend": "cd backend-node && npm run build",
    "build:desktop": "cd desktop && npm run dist",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": ["ai", "drama", "video", "storyboard", "seedance"],
  "author": "jiankujidu",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jiankujidu/LocalMiniDrama-Enhanced"
  },
  "bugs": {
    "url": "https://github.com/jiankujidu/LocalMiniDrama-Enhanced/issues"
  },
  "homepage": "https://github.com/jiankujidu/LocalMiniDrama-Enhanced"
}
