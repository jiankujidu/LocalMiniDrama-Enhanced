{
  "name": "upingdrama-desktop",
  "version": "1.3.0",
  "description": "UpingDrama 桌面客户端",
  "main": "main.js",
  "author": "jiankujidu",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build:front": "cd ../frontweb && npm run build",
    "copy-front": "node scripts/copy-front.js",
    "dist": "npm run build:front && npm run copy-front && electron-builder --win",
    "dist:mac": "electron-builder --mac"
  },
  "dependencies": {
    "@volcengine/openapi": "^1.36.1",
    "adm-zip": "^0.5.16",
    "better-sqlite3": "^11.6.0",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "js-yaml": "^4.0.0",
    "jsonrepair": "^3.0.0",
    "jsonwebtoken": "^9.0.0",
    "multer": "^1.4.5-lts.1",
    "sharp": "^0.33.0",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.upingdrama.desktop",
    "productName": "UpingDrama",
    "artifactName": "UpingDrama-${version}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "package.json",
      "backend-node/**/*",
      "frontweb/dist/**/*",
      "node_modules/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.icns"
    }
  }
}
